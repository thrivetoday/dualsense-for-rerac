+
+    /// The lightbar's colour, `None` to leave it to the pad (once set, it keeps the last colour until turned off).
+    pub fn set_lightbar(&self, c: Option<Rgb>) { *self.0.lightbar.lock().unwrap_or_else(|e| e.into_inner()) = c; }
